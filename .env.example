EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Development preview only. Keep false for production APK builds.
EXPO_PUBLIC_SKIP_COMPANION_ONBOARDING=false

# Required for production calls and screen viewing across different networks.
# Provide both UDP/TCP TURN and TLS TURN endpoints, separated by commas.
EXPO_PUBLIC_TURN_URLS=turn:your-turn.example.com:3478?transport=udp,turn:your-turn.example.com:3478?transport=tcp,turns:your-turn.example.com:5349?transport=tcp
EXPO_PUBLIC_TURN_USERNAME=your-short-lived-turn-username
EXPO_PUBLIC_TURN_CREDENTIAL=your-short-lived-turn-credential

# Hidden by default. Also requires the trusted server-side education feature switch.
EXPO_PUBLIC_ENABLE_EDUCATION_ADMIN=false
