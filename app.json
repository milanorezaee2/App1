{
  "expo": {
    "name": "MiloMultiApp",
    "slug": "companion-english",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "companionenglish",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.devicecontrol.companion",
      "versionCode": 5,
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "برای تمرین تلفظ جمله‌ها، اجازه استفاده از میکروفن را بدهید."
        }
      ],
      "@config-plugins/react-native-webrtc",
      "./plugins/withMediaProjectionService",
      "./plugins/withCompanionAccessibility",
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so",
                "**/libjsc.so",
                "**/libfbjni.so"
              ]
            }
          }
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/App1",
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "sitemap": false
      }
    }
  }
}
